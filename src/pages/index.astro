---
import Base from '../layouts/Base.astro';
import TireCard from '../components/TireCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { GUIDES, guideUrl } from '../lib/all-guides';
import { siteLines, siteSizes, siteBrands, lineUrl, sizeUrl, S, jsonLd } from '../lib/data';
const feat = [...siteLines].sort((a, b) => b.wear_median! - a.wear_median!).slice(0, 6);
const popular = ["225-65r17","235-65r17","205-55r16","215-60r16","235-55r19","245-45r18","265-70r17","225-45r17"].map((k) => siteSizes.find((s) => s.key === k)).filter((s) => !!s) as typeof siteSizes;
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'TireMileage', url: Astro.site!.href, description: 'Tire treadwear (UTQG) grades from NHTSA data with size rankings and a cost-per-mile calculator.' }];
---
<Base title="Tire Treadwear Ratings & Cost-per-Mile Calculator (NHTSA UTQG Data)" description={`Compare tire treadwear, traction and temperature grades from ${S.raw_records.toLocaleString()} NHTSA UTQG records, by tire line and by size, with a cost-per-mile calculator.`} ld={ld}>
  <section class="hero" aria-labelledby="h1">
    <p class="eyebrow" style="color:#9fb8d6;position:relative">Independent · built on U.S. government data</p>
    <h1 id="h1">Find tires that actually last.</h1>
    <p class="lead">Compare treadwear, wet traction and heat grades for {S.normalized_lines.toLocaleString()} tire lines from {S.normalized_brands} brands, ranked by size, then click through to a retailer to buy.</p>
    <h2 class="flow-h" id="find-h">Find tires for your size</h2>
    <form id="size-lookup" class="lookup" action="/sizes/" role="search" aria-labelledby="find-h">
      <label class="sr" for="size-in">Tire size, for example 225/65R17</label>
      <input id="size-in" name="size" inputmode="text" autocomplete="off" placeholder="Enter your size, e.g. 225/65R17" aria-describedby="lookup-msg how-line" />
      <button type="submit">Find tires for my size</button>
    </form>
    <p id="lookup-msg" class="lookup-msg" role="status" aria-live="polite"></p>
    <p id="how-line" class="how-line"><strong>How it works:</strong> look up the treadwear, compare tires for your size, then click through to Amazon or Discount Tire to buy. TireMileage doesn’t sell tires; we link to retailers. <a href="/where-to-buy/">Where to buy</a></p>
    <div class="chips" aria-label="Popular sizes">{popular.map((s) => <a class="chip" href={sizeUrl(s.key)}>{s.label}</a>)}</div>
  </section>

  <section aria-labelledby="how-h">
    <h2 id="how-h">How it works</h2>
    <ol class="steps">
      <li><h3>Enter your size</h3><p>Type the size from your sidewall (like 225/65R17). We rank every tire line NHTSA lists for it.</p></li>
      <li><h3>Compare the grades</h3><p>Treadwear gauge plus color-coded traction and temperature badges. Optional: work out cost per 1,000 miles with a real quote.</p></li>
      <li><h3>Click through to buy</h3><p>Use <strong>Check price</strong> buttons to open Amazon or Discount Tire. We don’t sell tires or show prices; you check price and fit at the retailer. <a href="/where-to-buy/">Details</a></p></li>
    </ol>
  </section>

  <div class="stats" role="list">
    <div class="stat" role="listitem"><b>{S.raw_records.toLocaleString()}</b><span>NHTSA UTQG records</span></div>
    <div class="stat" role="listitem"><b>{S.normalized_lines.toLocaleString()}</b><span>tire lines</span></div>
    <div class="stat" role="listitem"><b>{S.normalized_brands}</b><span>brands</span></div>
    <div class="stat" role="listitem"><b>{S.distinct_explicit_sizes}</b><span>sizes named in the data</span></div>
  </div>

  <div class="answer"><strong>Quick answer:</strong> TireMileage turns the U.S. government’s tire grading data (NHTSA UTQG) into plain-English comparisons. Treadwear is a relative durability grade (higher = slower wear on NHTSA’s test), not a mileage promise. Pick a size or tire line, then click through to Amazon or Discount Tire to check the price and buy; the calculator turns your own quote into cost per 1,000 miles.</div>

  <div class="sec-h"><h2>Highest-treadwear lines</h2><a href="/tires/">All tire lines →</a></div>
  <p class="meta" style="margin-top:-4px">Open “View &amp; shop” on a card for the Check price buttons.</p>
  <div class="grid g3">{feat.map((l) => <TireCard l={l} />)}</div>

  <AdSlot slot="home-mid" height={250} />


  <div class="sec-h"><h2>Start with a guide</h2><a href="/guides/">All guides →</a></div>
  <ul class="rel">{['what-does-treadwear-rating-mean', 'dot-tire-date-code', 'load-index-and-speed-rating', 'why-your-size-may-be-missing', 'treadwear-vs-warranty-mileage', 'tire-cost-per-mile'].map((s) => { const g = GUIDES.find((x) => x.slug === s)!; return <li><a href={guideUrl(g)}>{g.h1}</a><span>{g.kicker}</span></li>; })}</ul>

  <div class="sec-h"><h2>Browse</h2></div>
  <div class="grid g3">
    <a class="card" href="/tires/"><h3>Tire lines by brand</h3><p class="meta">{siteLines.length} line pages across {siteBrands.length} brand hubs.</p></a>
    <a class="card" href="/sizes/"><h3>Sizes ranked by treadwear</h3><p class="meta">{siteSizes.length} size pages.</p></a>
    <a class="card" href="/guides/"><h3>Guides</h3><p class="meta">{GUIDES.length} sourced guides: treadwear, warranties, sidewalls, when to replace.</p></a>
    <a class="card" href="/treadwear/"><h3>By treadwear band</h3><p class="meta">Under 200 to 800 and up, with brand and grade breakdowns.</p></a>
    <a class="card" href="/type/"><h3>By category</h3><p class="meta">All-season, touring, performance, all-terrain, highway (name markers only).</p></a>
    <a class="card" href="/rim/"><h3>By rim diameter</h3><p class="meta">Every size NHTSA lists for each wheel diameter.</p></a>
    <a class="card" href="/methodology/"><h3>Methodology &amp; data</h3><p class="meta">Where every number comes from, plus CSV/JSON downloads.</p></a>
  </div>
  <p class="note"><strong>Honest limits.</strong> NHTSA publishes grades, not prices or warranties. We do not scrape retailers or guess numbers: prices are not shown, and a maker’s warranty mileage appears only where we cite the maker’s own page.</p>
</Base>
