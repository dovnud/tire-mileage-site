---
import Chips from '../../../components/Chips.astro';
import GuideLinks from '../../../components/GuideLinks.astro';
import { guidesForLine } from '../../../lib/guide-picks';
import { guideBySlug, guideUrl } from '../../../lib/all-guides';
import { lineChips, lineBand } from '../../../lib/taxonomy';
import { ogSlugForLine } from '../../../lib/og';
import Base from '../../../layouts/Base.astro';
import CostCalc from '../../../components/CostCalc.astro';
import Gauge from '../../../components/Gauge.astro';
import Badge from '../../../components/Badge.astro';
import WhereToBuy from '../../../components/WhereToBuy.astro';
import ShopCta from '../../../components/ShopCta.astro';
import ShopBar from '../../../components/ShopBar.astro';
import { MAKER_FACTS } from '../../../lib/makers';
import { wearPct, wearTier } from '../../../lib/data';
import { siteLines, allLines, recordsFor, hasLine, lineUrl, sizeUrl, sizeSet, S, UPDATED, fmt, range, pct, ordinal, wearBand, TRACTION, TEMPERATURE, mostCommon, trendLabel, SOURCE_URL, NHTSA_GUIDE, CFR_URL } from '../../../lib/data';
export function getStaticPaths() { return siteLines.map((l) => ({ params: { brand: l.brand_slug, line: l.line_slug }, props: { l } })); }
const { l } = Astro.props as { l: (typeof allLines)[number] };
const name = `${l.brand} ${l.line}`;
const recs = recordsFor(l);
const explicit = recs.filter((r) => r.size_key);
const band = wearBand(l.wear_median!);
const trac = mostCommon(l.traction), temp = mostCommon(l.temperature);
const lowerShare = l.wear_percentile!;
const RATED_N = allLines.filter((x) => x.wear_percentile != null).length;
const brandLines = allLines.filter((x) => x.brand_slug === l.brand_slug && x.wear_median != null).sort((a, b) => (a.brand_rank ?? 0) - (b.brand_rank ?? 0));
const shown = [...recs].sort((a, b) => (b.treadwear ?? 0) - (a.treadwear ?? 0) || a.size_raw.localeCompare(b.size_raw)).slice(0, 80);
const sizeLinks = [...new Set(explicit.map((r) => r.size_key))].filter((k) => sizeSet.has(k));
const rank = l.brand_rank!;
const maker = MAKER_FACTS[`${l.brand_slug}/${l.line_slug}`];
const arc = 2 * Math.PI * 80 / 2; // semicircle length for r=80
const above = brandLines.find((x) => x.brand_rank === rank - 1), below = brandLines.find((x) => x.brand_rank === rank + 1);
const spread = l.wear_min === l.wear_max ? `a single treadwear grade of ${l.wear_min}` : `treadwear grades from ${l.wear_min} to ${l.wear_max} (median ${fmt(l.wear_median)})`;
const answer = `${name} has ${spread} across ${l.records} NHTSA UTQG record${l.records === 1 ? '' : 's'}${trac ? `, traction ${trendLabel(l.traction)}` : ''}${temp ? ` and temperature ${trendLabel(l.temperature)}` : ''}. Its median treadwear is higher than ${pct(lowerShare)}% of the ${RATED_N.toLocaleString()} tire lines in the dataset, and ranks #${rank} of ${l.brand_lines_rated} rated ${l.brand} lines.`;
const t1 = `${name} Treadwear Rating & UTQG Grades (NHTSA data)`, t2 = `${name} Treadwear & UTQG Grades`;
const title = t1.length <= 70 ? t1 : t2.length <= 90 ? t2 : `${name.slice(0, 60).replace(/\s+\S*$/, '')}… Treadwear & UTQG`;
const description0 = `${name}: NHTSA UTQG treadwear ${range(l.wear_min, l.wear_max)}${trac ? `, traction ${trac}` : ''}${temp ? `, temperature ${temp}` : ''}. Rank #${rank} of ${l.brand_lines_rated} ${l.brand} lines; cost-per-mile calculator.`;
const description = description0.length <= 200 ? description0 : description0.replace('; cost-per-mile calculator.', '.').slice(0, 200);
const faqs = [
  { q: `What is the treadwear rating of the ${name}?`, a: `NHTSA's UTQG data lists ${spread} for the ${name}, from ${l.records} record${l.records === 1 ? '' : 's'}. Treadwear is graded in multiples of 20 relative to a government control tire graded 100; it is not a mileage guarantee.` },
  { q: `Is the ${name} treadwear grade high or low?`, a: `A grade of ${fmt(l.wear_median)} is ${band.text} Compared with every line in the NHTSA data, the median is higher than ${pct(lowerShare)}% of lines (dataset median ${fmt(S.treadwear_overall_median)}). Within ${l.brand} it ranks #${rank} of ${l.brand_lines_rated}.` },
  { q: `What is the cost per mile of the ${name}?`, a: `We do not have a licensed price or warranty-mileage feed yet, so we do not state a cost per mile. Use the formula cost per 1,000 miles = price per set ÷ (expected miles ÷ 1,000) with your own quote and mileage expectation, or the calculator on this page.` },
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: new URL(Astro.url.pathname, Astro.site).href, dateModified: UPDATED, isBasedOn: SOURCE_URL, about: { '@type': 'Thing', name } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Tire lines', href: '/tires/' }, { name: l.brand, href: `/tires/${l.brand_slug}/` }, { name: l.line, href: lineUrl(l) }];
const chips = lineChips(l);
const guideSlugs = guidesForLine(l);
const linkedGuide = guideBySlug(guideSlugs[3] ?? guideSlugs[0]);
const tband = lineBand(l);
const similar = allLines.filter((x) => x.wear_median != null && x.brand_slug !== l.brand_slug && hasLine(x) && lineBand(x).slug === tband.slug).sort((a, b) => Math.abs((a.wear_median as number) - (l.wear_median as number)) - Math.abs((b.wear_median as number) - (l.wear_median as number)) || a.brand.localeCompare(b.brand)).slice(0, 6);
---
<Base title={title} description={description} crumbs={crumbs} ld={ld} og={ogSlugForLine(l)}>
  <div class="lhead">
    <div>
      <p class="eyebrow">{l.brand} · tire line</p>
      <h1>{name}: treadwear rating &amp; UTQG grades</h1>
      {maker && maker.makerName !== l.line && <p class="sub">Sold by {l.brand} as <strong>{l.brand} {maker.makerName}</strong>; NHTSA files it as “{l.line}”.</p>}
      <ShopCta brand={l.brand} line={l.line} brandSlug={l.brand_slug} lineSlug={l.line_slug} />
      <Chips chips={chips} label="Tags for this tire line" />
      <div class="answer"><strong>Quick answer:</strong> {answer}</div>
    </div>
    <div class="card score" aria-label="Grade summary">
      <div class="t"><h2 style="margin:0;font-size:var(--fs-3)">Grade summary</h2><span class="meta">NHTSA UTQG</span></div>
      <svg class={`dial ${wearTier(l.wear_median!)}`} viewBox="0 0 200 118" role="img" aria-label={`Median treadwear ${fmt(l.wear_median)} on a 0 to 1000 scale`}>
        <path d="M20 100 A80 80 0 0 1 180 100" fill="none" stroke="var(--track)" stroke-width="16" stroke-linecap="round" />
        <path d="M20 100 A80 80 0 0 1 180 100" fill="none" stroke="var(--c)" stroke-width="16" stroke-linecap="round" stroke-dasharray={`${(arc * wearPct(l.wear_median!)) / 100} ${arc}`} />
        <text x="100" y="88" text-anchor="middle" font-size="38" font-weight="800" fill="var(--fg)">{fmt(l.wear_median)}</text>
        <text x="100" y="108" text-anchor="middle" font-size="11" fill="var(--mut)">median treadwear</text>
      </svg>
      <p class="meta" style="text-align:center;margin:0">Higher than {pct(lowerShare)}% of {RATED_N.toLocaleString()} lines · #{rank} of {l.brand_lines_rated} {l.brand} lines</p>
      <div class="badges"><Badge kind="traction" grade={trac} big /><Badge kind="temp" grade={temp} big /></div>
    </div>
  </div>

  <div class="cols-2">
  <div>
  <h2>Key facts</h2>
  <div class="tw"><table class="facts">
    <tbody>
      <tr><th scope="row">Treadwear (NHTSA UTQG)</th><td><Gauge value={l.wear_median!} min={l.wear_min} max={l.wear_max} size="lg" scale label={`median · range ${range(l.wear_min, l.wear_max)} · band ${band.band}`} /></td></tr>
      <tr><th scope="row">Traction grade(s)</th><td>{trac ? <Badge kind="traction" grade={trac} /> : '—'} <span class="meta">{trendLabel(l.traction)}</span></td></tr>
      <tr><th scope="row">Temperature grade(s)</th><td>{temp ? <Badge kind="temp" grade={temp} /> : '—'} <span class="meta">{trendLabel(l.temperature)}</span></td></tr>
      <tr><th scope="row">Percentile (all lines)</th><td>Median treadwear higher than {pct(lowerShare)}% of {RATED_N.toLocaleString()} lines</td></tr>
      <tr><th scope="row">Rank within {l.brand}</th><td>#{rank} of {l.brand_lines_rated} rated lines (by median treadwear)</td></tr>
      <tr><th scope="row">NHTSA records</th><td>{l.records} total; {l.records_with_explicit_size} name a specific size ({l.explicit_sizes} distinct sizes)</td></tr>
      <tr><th scope="row">Warranty miles</th><td>{maker?.warranty ? <span>{maker.warranty.text}. <a href={maker.warranty.sourceUrl} target="_blank" rel="noopener">Source</a></span> : 'Not shown (no maker-published figure verified)'}</td></tr>
      <tr><th scope="row">Price</th><td>Not shown (varies by size and store); see “Where to buy”</td></tr>
    </tbody>
  </table></div>

  <h2>What these grades mean in plain English</h2>
  <ul>
    <li><strong>Treadwear {fmt(l.wear_median)}:</strong> this is {band.text} Under UTQG a grade of 200 should wear twice as long as the grade-100 control tire on NHTSA's test course; real-world mileage varies with driving, rotation, alignment and climate.</li>
    {trac && <li><strong>Traction {trac}:</strong> {TRACTION[trac]} Traction is straight-ahead wet braking only; it does not measure cornering or hydroplaning.</li>}
    {temp && <li><strong>Temperature {temp}:</strong> {TEMPERATURE[temp]}</li>}
    <li>Grades on one line often change by size: <a href="/guides/why-treadwear-grades-differ-by-size/">why treadwear grades differ by size</a>. Age is a separate mark: <a href="/guides/dot-tire-date-code/">how to read the DOT date code</a>. Also: <a href={guideUrl(linkedGuide)}>{linkedGuide.h1}</a>.</li>
    {above && <li>Ranked just above in {l.brand}: <a href={hasLine(above) ? lineUrl(above) : `/tires/${l.brand_slug}/`}>{above.line}</a> (median {fmt(above.wear_median)}).</li>}
    {below && <li>Ranked just below in {l.brand}: <a href={hasLine(below) ? lineUrl(below) : `/tires/${l.brand_slug}/`}>{below.line}</a> (median {fmt(below.wear_median)}).</li>}
  </ul>

  <h2>NHTSA records for {name}</h2>
  <p>Each row is one NHTSA record as filed by the manufacturer. Sizes are shown exactly as NHTSA lists them; entries such as “All sizes” apply a single grade to several sizes and cannot be matched to one specific size.</p>
  <div class="tw"><table data-sortable>
    <thead><tr><th>Size (as filed)</th><th class="n">Treadwear</th><th>Traction</th><th>Temperature</th></tr></thead>
    <tbody>{shown.map((r) => <tr><td>{r.size_key && sizeSet.has(r.size_key) ? <a href={sizeUrl(r.size_key)}>{r.size_raw}</a> : r.size_raw}</td><td class="n" data-v={r.treadwear ?? ''}>{r.treadwear ?? 'unverified'}</td><td data-v={r.traction ?? ''}>{r.traction ? <Badge kind="traction" grade={r.traction} /> : 'unverified'}</td><td data-v={r.temperature ?? ''}>{r.temperature ? <Badge kind="temp" grade={r.temperature} /> : 'unverified'}</td></tr>)}</tbody>
  </table></div>
  {recs.length > shown.length && <p class="meta">Showing {shown.length} of {recs.length} records; the full set is in the <a href="/data/">dataset download</a>.</p>}
  {sizeLinks.length > 0 && <p>Compare this line with others in the same size: {sizeLinks.map((k, i) => <span><a href={sizeUrl(k)}>{k.replace('-', '/').replace('r', 'R')}</a>{i < sizeLinks.length - 1 ? ', ' : ''}</span>)}.</p>}

  <CostCalc tire={name} />

  <h2>Other {l.brand} lines by treadwear</h2>
  <div class="tw"><table data-sortable>
    <thead><tr><th class="n">Rank</th><th>Line</th><th class="n">Median treadwear</th></tr></thead>
    <tbody>{brandLines.slice(0, 12).map((x) => <tr><td class="n">{x.brand_rank}</td><td>{hasLine(x) ? <a href={lineUrl(x)}>{x.line}</a> : x.line}{x.line_slug === l.line_slug ? ' (this page)' : ''}</td><td class="n" data-v={x.wear_median}><Gauge value={x.wear_median!} min={x.wear_min} max={x.wear_max} /></td></tr>)}</tbody>
  </table></div>
  <p><a href={`/tires/${l.brand_slug}/`}>All {l.brand} lines →</a></p>

  {similar.length > 0 && <section class="relblock"><h2>Similar treadwear from other brands</h2><p>Other lines in the same treadwear band (<a href={`/treadwear/${tband.slug}/`}>{tband.label}</a>) with a page here: {similar.map((x, i) => <span><a href={lineUrl(x)}>{x.brand} {x.line}</a> ({fmt(x.wear_median)}){i < similar.length - 1 ? ', ' : ''}</span>)}.</p></section>}
  <GuideLinks slugs={guideSlugs} />

  <h2>FAQ</h2>
  {faqs.map((f) => <details open><summary>{f.q}</summary><p>{f.a}</p></details>)}

  <h2>Source and caveats</h2>
  <p>Source: <a href={SOURCE_URL}>NHTSA tire ratings API</a>, pulled {UPDATED}. Grade definitions: <a href={NHTSA_GUIDE}>NHTSA TireWise</a> and <a href={CFR_URL}>49 CFR 575.104</a>. Grades are self-reported by manufacturers. The NHTSA data has no “currently sold” flag (its <code>active</code> field is false on every record), so a listed line may be discontinued. See <a href="/methodology/">methodology</a>.</p>
  </div>
  <aside aria-label="Where to buy">
    <WhereToBuy brand={l.brand} line={l.line} brandSlug={l.brand_slug} lineSlug={l.line_slug} />
  </aside>
  </div>
  <ShopBar brand={l.brand} line={l.line} brandSlug={l.brand_slug} lineSlug={l.line_slug} />
</Base>
