---
import Base from '../../layouts/Base.astro';
import FaqList from '../../components/FaqList.astro';
import { siteSizes } from '../../lib/data';
import { AMAZON_DISCLOSURE } from '../../lib/retailers';
import { AFTER_REBATE_PATH, REBATE_PATH, REBATE_DATE, COMPARE_PATH, REPLACE_PATH } from '../../lib/paths';
import { afterRebateFaqs } from '../../lib/tool-faqs';
import { SITE_NAME } from '../../lib/site';
const title = 'Cost per Mile After a Tire Rebate';
const description = 'Subtract a rebate you type from a price you type. Cost per 1,000 miles uses your miles. Treadwear on a picked line is the NHTSA grade, not a mileage forecast.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Cost per mile after rebate', href: AFTER_REBATE_PATH }];
const faqs = afterRebateFaqs;
const ld = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
const hinted = ['michelin', 'bf-goodrich', 'goodyear', 'cooper', 'pirelli'];
---
<Base title={title} description={description} crumbs={crumbs} ld={ld} published={REBATE_DATE} modified={REBATE_DATE}>
  <p class="eyebrow">Tool · buying math</p>
  <h1>Cost per mile after a rebate</h1>
  <p class="guide-meta"><span>By {SITE_NAME}</span><span>Last updated <time datetime={REBATE_DATE}>{REBATE_DATE}</time></span></p>
  <div class="answer"><strong>Quick answer:</strong> Net set price is the price you type for the set, minus the rebate you type. Cost per 1,000 miles uses that net price and the miles you type. Nothing is pre-filled. A treadwear grade from NHTSA is shown when you pick a line that has a page here. It is not a mileage number and it is not a rebate.</div>

  <section class="calc" aria-labelledby="ar-h" data-rebate-path={REBATE_PATH} data-hinted={hinted.join(',')}>
    <h2 id="ar-h">Your two sets, after the rebate you type</h2>
    <p>Pick tire lines that already have a page here, or skip the lists and type a price, a rebate, and miles. The formula is <code>cost per 1,000 miles = (price per tire × tires in the set − rebate) ÷ (expected miles ÷ 1,000)</code>. Verified November and December 2026 maker amounts are on the <a href={REBATE_PATH}>tire rebate lookup</a>. They are not copied into these boxes. A worked example with invented numbers, and no rebate, is in the <a href="/guides/tire-cost-per-mile/">cost-per-mile guide</a>.</p>
    <p><label>Limit the suggestion lists to a size on this site
      <select id="ar-size">
        <option value="">Any size</option>
        {siteSizes.map((s) => <option value={s.key}>{s.label}</option>)}
      </select>
    </label></p>
    <div class="grid g2">
      <div class="card" data-side="a">
        <h3>Tire A</h3>
        <label>Find a tire line<input type="search" data-q autocomplete="off" placeholder="Brand or line" /></label>
        <ul class="rel" data-hits hidden></ul>
        <p data-picked></p>
        <div class="calc-form">
          <label>Price you were quoted per tire ($)<input data-price type="number" min="0" step="0.01" inputmode="decimal" /></label>
          <label>Tires in the set<input data-count type="number" min="1" step="1" value="4" /></label>
          <label>Rebate for the set ($)<input data-rebate type="number" min="0" step="0.01" inputmode="decimal" /></label>
          <label>Warranty miles or your estimate<input data-miles type="number" min="1" step="1" inputmode="numeric" /></label>
        </div>
        <p class="meta" data-warr></p>
        <p class="meta" data-hint></p>
      </div>
      <div class="card" data-side="b">
        <h3>Tire B</h3>
        <label>Find a tire line<input type="search" data-q autocomplete="off" placeholder="Brand or line" /></label>
        <ul class="rel" data-hits hidden></ul>
        <p data-picked></p>
        <div class="calc-form">
          <label>Price you were quoted per tire ($)<input data-price type="number" min="0" step="0.01" inputmode="decimal" /></label>
          <label>Tires in the set<input data-count type="number" min="1" step="1" value="4" /></label>
          <label>Rebate for the set ($)<input data-rebate type="number" min="0" step="0.01" inputmode="decimal" /></label>
          <label>Warranty miles or your estimate<input data-miles type="number" min="1" step="1" inputmode="numeric" /></label>
        </div>
        <p class="meta" data-warr></p>
        <p class="meta" data-hint></p>
      </div>
    </div>
    <h2>Result</h2>
    <output id="ar-out" aria-live="polite">Enter a price, a rebate, and expected miles for each tire. Type 0 when a quote has no rebate.</output>
    <p class="meta">{AMAZON_DISCLOSURE} Search on Amazon is an affiliate link. Discount Tire links are plain searches. Both open from a tire you pick. Retailer links never change the arithmetic. Maker rebate rules can exclude a retailer; the lookup names the exclusions we read.</p>
  </section>

  <h2>How the after-rebate figure is defined</h2>
  <p>This is arithmetic on your inputs, not a road test and not a statement that a rebate will be paid.</p>
  <ul>
    <li><strong>Gross set price</strong> is the price per tire times the number of tires.</li>
    <li><strong>Net set price</strong> is the gross set price minus the rebate you type for that set.</li>
    <li><strong>Cost per 1,000 miles</strong> uses the net set price and the miles you typed. The result also shows the gross figure so you can see what the rebate changed.</li>
    <li><strong>Break-even miles</strong> use the net set prices. They are how far the higher net set must last so its cost per mile matches the lower net set: higher net set price × the lower set’s expected miles ÷ the lower net set price.</li>
    <li>A maker’s mileage warranty is a ceiling the maker will stand behind, not a forecast. See <a href="/guides/treadwear-vs-warranty-mileage/">treadwear versus warranty mileage</a>. Tires are worn out at 2/32 inch on the <a href={REPLACE_PATH}>replacement lookup</a>.</li>
  </ul>
  <p>The same comparison without a rebate box is <a href={COMPARE_PATH}>compare two tires by cost per mile</a>. Dates we could verify are on the <a href={REBATE_PATH}>tire rebate lookup</a>.</p>

  <FaqList faqs={faqs} />
  <section class="sources" aria-labelledby="src-h"><h2 id="src-h">Sources</h2>
    <ol>
      <li>The cost-per-1,000-miles formula is this site’s arithmetic, the same one documented in <a href="/guides/tire-cost-per-mile/">How to calculate tire cost per mile</a>, applied to the net set price. No outside price source is used.</li>
      <li>Treadwear grades shown for a picked line come from <a href="https://api.nhtsa.gov/tires?dataSet=ratings" rel="noopener">NHTSA’s tire ratings API</a>, via the dataset on <a href="/data/">this site</a>. They are not miles.</li>
      <li>Warranty sentences appear only for lines listed in our maker-facts file, each with the maker’s page linked beside the sentence.</li>
      <li>Rebate amounts are not stored here. The <a href={REBATE_PATH}>lookup</a> cites the manufacturer pages read on {REBATE_DATE}.</li>
    </ol>
  </section>
</Base>
<script>
  const hinted = (document.querySelector('[data-hinted]')?.getAttribute('data-hinted') || '').split(',').filter(Boolean);
  const rebatePath = document.querySelector('[data-rebate-path]')?.getAttribute('data-rebate-path') || '/tools/tire-rebates/';
  const norm = (s: string) => s.toLowerCase().replace(/[\/\-_.,()+]+/g, ' ').replace(/\s+/g, ' ').trim();
  const money = (n: number) => '$' + n.toFixed(2);
  const perMile = (n: number) => '$' + n.toFixed(4);
  const milesFmt = (n: number) => Math.round(n).toLocaleString('en-US');
  let rows: Row[] = [];
  const load = () => rows.length ? Promise.resolve(rows) : fetch('/tools/lines.json').then((r) => r.json()).then((j: { lines: Row[] }) => { rows = j.lines; return rows; });
  const sizeSel = document.getElementById('ar-size') as HTMLSelectElement;
  const out = document.getElementById('ar-out') as HTMLOutputElement;

  function sideBox(el: HTMLElement) {
    const price = el.querySelector<HTMLInputElement>('[data-price]')!;
    const count = el.querySelector<HTMLInputElement>('[data-count]')!;
    const rebate = el.querySelector<HTMLInputElement>('[data-rebate]')!;
    const miles = el.querySelector<HTMLInputElement>('[data-miles]')!;
    const name = (el.querySelector('[data-picked] a')?.textContent || el.querySelector('h3')?.textContent || 'This set').trim();
    const pr = price.value === '' ? NaN : parseFloat(price.value);
    const n = parseFloat(count.value);
    const rb = rebate.value === '' ? NaN : parseFloat(rebate.value);
    const mi = parseFloat(miles.value);
    if (!(pr >= 0) || !(n >= 1) || !(rb >= 0) || !(mi > 0)) return null;
    const gross = pr * n;
    if (rb > gross + 0.001) return { name, error: true as const, gross, rebate: rb };
    const set = gross - rb;
    return { name, error: false as const, gross, rebate: rb, set, miles: mi, per1k: set / (mi / 1000), grossPer1k: gross / (mi / 1000), perMile: set / mi };
  }

  function render() {
    const boxes = [...document.querySelectorAll<HTMLElement>('[data-side]')];
    const a = sideBox(boxes[0]);
    const b = sideBox(boxes[1]);
    if (!a || !b) { out.textContent = 'Enter a price, a rebate, and expected miles for each tire. Type 0 when a quote has no rebate. Prices and rebates stay blank until you type them.'; return; }
    if (a.error || b.error) {
      const who = [a, b].filter((x) => x.error).map((x) => `${x.name} (rebate ${money(x.rebate)} is larger than the set price ${money(x.gross)})`);
      out.textContent = `The rebate is larger than the set price for ${who.join(' and ')}. Cost per mile is not computed for that case. Check the amount against the maker page and your receipt.`;
      return;
    }
    const lines = [
      `${a.name}: set ${money(a.gross)} before rebate, ${money(a.set)} after a ${money(a.rebate)} rebate, ${money(a.per1k)} per 1,000 miles after rebate (${perMile(a.perMile)} per mile) over ${milesFmt(a.miles)} miles. Before the rebate that set is ${money(a.grossPer1k)} per 1,000 miles.`,
      `${b.name}: set ${money(b.gross)} before rebate, ${money(b.set)} after a ${money(b.rebate)} rebate, ${money(b.per1k)} per 1,000 miles after rebate (${perMile(b.perMile)} per mile) over ${milesFmt(b.miles)} miles. Before the rebate that set is ${money(b.grossPer1k)} per 1,000 miles.`,
    ];
    const cheaper = a.per1k < b.per1k ? a : b.per1k < a.per1k ? b : null;
    if (cheaper) lines.push(`Lower cost per 1,000 miles after the rebates you typed: ${cheaper.name}.`);
    else lines.push('The two sets have the same cost per 1,000 miles after the rebates you typed.');
    if (Math.abs(a.set - b.set) < 0.005) {
      lines.push('The net set prices match, so there is no higher net set. Break-even miles are not a separate number in that case.');
    } else {
      const hi = a.set > b.set ? a : b;
      const lo = a.set > b.set ? b : a;
      if (lo.set === 0) lines.push('The lower net set price is zero, so the break-even division is not used.');
      else {
        const be = (hi.set * lo.miles) / lo.set;
        const cmp = hi.miles > be + 0.5 ? 'above' : hi.miles < be - 0.5 ? 'below' : 'equal to';
        lines.push(`Break-even on the net prices: ${hi.name} must last ${milesFmt(be)} miles to match ${lo.name}’s cost per mile. The miles you entered for ${hi.name} are ${cmp} that break-even.`);
      }
    }
    out.textContent = lines.join(' ');
  }

  function paintPick(el: HTMLElement, row: Row) {
    const picked = el.querySelector('[data-picked]')!;
    picked.replaceChildren();
    const page = document.createElement('a');
    page.href = row.url + '#remind-h';
    page.textContent = row.name;
    picked.append(page, ' · NHTSA median treadwear ', String(row.wear ?? '—'), '. ');
    const amz = document.createElement('a');
    amz.href = row.amazon;
    amz.target = '_blank';
    amz.rel = 'sponsored nofollow noopener';
    amz.textContent = 'Search on Amazon';
    const dt = document.createElement('a');
    dt.href = row.discount;
    dt.target = '_blank';
    dt.rel = 'sponsored nofollow noopener';
    dt.textContent = 'Search at Discount Tire';
    picked.append(amz, ' · ', dt);
    const warr = el.querySelector('[data-warr]')!;
    warr.replaceChildren();
    if (row.warranty && row.warrantyUrl) {
      warr.append('Cited warranty (not filled into the miles box): ' + row.warranty + '. ');
      const src = document.createElement('a');
      src.href = row.warrantyUrl;
      src.rel = 'noopener';
      src.target = '_blank';
      src.textContent = row.warrantyLabel || 'Source';
      warr.append(src);
    } else warr.textContent = 'No maker treadwear-warranty figure is cited for this line. Type the miles from your paperwork, or your own estimate.';
    const hint = el.querySelector('[data-hint]')!;
    hint.replaceChildren();
    const slug = row.url.split('/').filter(Boolean)[1] || '';
    if (hinted.includes(slug)) {
      hint.append('This brand is named on the ');
      const a = document.createElement('a');
      a.href = rebatePath;
      a.textContent = 'November–December 2026 rebate lookup';
      hint.append(a, '. That page does not fill the rebate box. Confirm the model, the dealer, and the purchase date on the maker’s page.');
    }
    render();
  }

  async function suggest(el: HTMLElement) {
    const q = el.querySelector<HTMLInputElement>('[data-q]')!;
    const list = el.querySelector<HTMLUListElement>('[data-hits]')!;
    const all = await load();
    const size = sizeSel.value;
    const toks = norm(q.value).split(' ').filter(Boolean);
    const pool = all.filter((r) => !size || r.sizes.includes(size));
    const hits = !toks.length ? [] : pool.filter((r) => toks.every((t) => norm(r.name).includes(t))).slice(0, 8);
    list.replaceChildren();
    if (!toks.length) { list.hidden = true; return; }
    if (!hits.length) {
      const li = document.createElement('li');
      li.textContent = size ? 'No matching line in this size on this site. Clear the size or type the price, rebate, and miles without a line.' : 'No matching line on this site. You can still type a price, a rebate, and miles.';
      list.append(li);
      list.hidden = false;
      return;
    }
    for (const row of hits) {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = `${row.name} · treadwear ${row.wear ?? '—'}`;
      btn.addEventListener('click', () => { q.value = row.name; list.hidden = true; paintPick(el, row); });
      li.append(btn);
      list.append(li);
    }
    list.hidden = false;
  }

  document.querySelectorAll<HTMLElement>('[data-side]').forEach((el) => {
    const q = el.querySelector<HTMLInputElement>('[data-q]')!;
    q.addEventListener('focus', () => void load());
    q.addEventListener('input', () => void suggest(el));
    el.querySelectorAll('input').forEach((input) => input.addEventListener('input', render));
  });
  sizeSel.addEventListener('change', () => { document.querySelectorAll<HTMLElement>('[data-side]').forEach((el) => void suggest(el)); });
</script>
