---
// Sticky bottom bar (mobile only). Amazon search only, so the paying action is the one thumb target.
import { enabledRetailers, buildRetailerUrl, buildSizeRetailerUrl, LINK_REL, AMAZON_DISCLOSURE } from '../lib/retailers';
const { brand, line, brandSlug, lineSlug, sizeLabel } = Astro.props as {
  brand?: string; line?: string; brandSlug?: string; lineSlug?: string; sizeLabel?: string;
};
const amazon = enabledRetailers().find((r) => r.id === 'amazon');
const href = amazon
  ? (sizeLabel ? buildSizeRetailerUrl('amazon', sizeLabel) : buildRetailerUrl('amazon', brand!, line!, `${brandSlug}/${lineSlug}`))
  : '';
const label = sizeLabel ? `Search ${sizeLabel} tires on Amazon` : 'Search on Amazon';
---
{href && <div class="shopbar" hidden role="region" aria-label={sizeLabel ? `Shop ${sizeLabel} tires` : 'Shop this tire'}>
  <div class="shopbar-in">
    <a class="sbtn sbtn-amz" href={href} target="_blank" rel={LINK_REL} data-shop="amazon">{label}<span class="sr"> (opens in a new tab)</span></a>
  </div>
  <p class="shopbar-fine">{AMAZON_DISCLOSURE} <a href="/where-to-buy/">How buying works</a></p>
</div>
<script is:inline>
(function () {
  var bar = document.querySelector('.shopbar');
  var target = document.getElementById('shop-this-tire') || document.getElementById('shop-size');
  if (!bar) return;
  function show(on) { bar.hidden = !on; }
  if (!target || !('IntersectionObserver' in window)) { show(true); return; }
  new IntersectionObserver(function (entries) { show(!entries[0].isIntersecting); }, { threshold: 0.2 }).observe(target);
})();
</script>}
