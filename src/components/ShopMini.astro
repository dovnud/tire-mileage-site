---
// Compact per-row Shop buttons for tables (size ranking, brand lists). Retailer search for that tire line.
import { enabledRetailers, buildRetailerUrl, LINK_REL } from '../lib/retailers';
const { brand, line, brandSlug, lineSlug } = Astro.props as { brand: string; line: string; brandSlug: string; lineSlug: string };
const key = `${brandSlug}/${lineSlug}`;
const name = `${brand} ${line}`;
---
<span class="shop-mini" data-shop-row>
  {enabledRetailers().map((r) => <a class={`sbtn sbtn-sm ${r.id === 'amazon' ? 'sbtn-amz' : 'sbtn-ac'}`} href={buildRetailerUrl(r.id, brand, line, key)} target="_blank" rel={LINK_REL} data-shop={r.id}>{r.name}<span class="sr"> – shop {name} (opens in a new tab)</span></a>)}
</span>
