---
// "Shop <size> tires" block at the top of size pages: retailer search links for the size itself.
import { enabledRetailers, buildSizeRetailerUrl, LINK_REL, AMAZON_DISCLOSURE } from '../lib/retailers';
const { label } = Astro.props as { label: string };
---
<section class="shop-cta shop-size" id="shop-size" aria-labelledby="shop-size-h">
  <h2 id="shop-size-h">Shop {label} tires</h2>
  <p class="shop-sub">TireMileage doesn’t sell tires. Pick a line from the ranking below and use its Shop button, or search every {label} tire at a retailer:</p>
  <div class="shop-btns">
    {enabledRetailers().map((r) => <a class={`sbtn ${r.id === 'amazon' ? 'sbtn-amz' : 'sbtn-ac'}`} href={buildSizeRetailerUrl(r.id, label)} target="_blank" rel={LINK_REL} data-shop={r.id}>Shop {label} tires {r.id === 'amazon' ? 'on' : 'at'} {r.name}<span aria-hidden="true"> ↗</span><span class="sr"> (opens in a new tab)</span></a>)}
  </div>
  <p class="shop-fine">{AMAZON_DISCLOSURE} The Amazon button is an affiliate link and may earn us a commission at no cost to you. Confirm the size fits your vehicle before you buy. <a href="/where-to-buy/">How buying works</a></p>
</section>
