---
import { enabledRetailers, buildRetailerUrl, retailerQuery, LINK_REL, CHECKED_ON, AMAZON_DISCLOSURE } from '../lib/retailers';
import { MAKER_FACTS } from '../lib/makers';
const { brand, line, brandSlug, lineSlug } = Astro.props as { brand: string; line: string; brandSlug: string; lineSlug: string };
const key = `${brandSlug}/${lineSlug}`;
const fact = MAKER_FACTS[key];
const q = retailerQuery(brand, line, key);
---
<section class="buy" aria-labelledby="buy-h">
  <h2 id="buy-h">Where to buy / check current price</h2>
  <p class="meta" style="margin:0 0 4px">Search results for “{q}”. We don’t show prices: they change by size and store, so check the retailer.</p>
  <ul>
    {enabledRetailers().map((r) => <li><a class="rl" href={buildRetailerUrl(r.id, brand, line, key)} target="_blank" rel={LINK_REL}>{r.name}<span>Search ↗</span></a></li>)}
  </ul>
  {fact?.warranty && (
    <div class="warranty"><b>Maker’s mileage warranty</b>{fact.warranty.text}. <a href={fact.warranty.sourceUrl} target="_blank" rel="noopener">Source: {fact.warranty.sourceLabel}</a>, read {fact.warranty.retrieved}.{fact.warranty.note && <span class="meta"><br />{fact.warranty.note}</span>}</div>
  )}
  <p class="meta" style="margin:0"><strong>Disclosure:</strong> {AMAZON_DISCLOSURE} The Amazon link is an affiliate link; the other links go to retailer search pages with no tracking (checked {CHECKED_ON}). Rankings never depend on commissions. A listed line may be discontinued or sold under a slightly different name.</p>
</section>
