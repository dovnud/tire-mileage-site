---
import '../styles/global.css';
import { PREVIEW, UPDATED, S, jsonLd } from '../lib/data';
import { SITE_NAME, GA4_ID, LEGAL_LINKS } from '../lib/site';
import { AMAZON_DISCLOSURE } from '../lib/retailers';
import Crumbs from '../components/Crumbs.astro';
import Logo from '../components/Logo.astro';
interface Props { title: string; description: string; crumbs?: { name: string; href: string }[]; ld?: unknown[]; noindex?: boolean; og?: string; ogType?: 'website' | 'article'; published?: string; modified?: string; }
const { title, description, crumbs = [], ld = [], noindex = false, og = 'default', ogType = 'website', published, modified } = Astro.props;
const ogImage = new URL(`/og/${og}.png`, Astro.site!.origin).href;
const origin = Astro.site!.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const crumbLd = crumbs.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, origin).href })) } : null;
const graphs = [...(crumbLd ? [crumbLd] : []), ...ld];
const path = Astro.url.pathname;
const nav: [string, string, string?][] = [['Tire lines', '/tires/'], ['Sizes', '/sizes/'], ['Where to buy', '/where-to-buy/', 'nav-buy'], ['Guides', '/guides/'], ['Methodology', '/methodology/', 'nav-extra'], ['Data', '/data/', 'nav-extra'], ['About', '/about/', 'nav-extra']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#0b2545" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {(PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content={ogType} /><meta property="og:site_name" content={SITE_NAME} /><meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
  {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
  {ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
  <link rel="alternate" type="application/atom+xml" href="/guides/feed.xml" title="TireMileage guides" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  {graphs.map((g) => <script type="application/ld+json" set:html={jsonLd(g)} />)}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-h"><div class="wrap in">
  <a class="logo" href="/" aria-label={`${SITE_NAME} home`}><Logo /></a>
  <nav class="nav" aria-label="Main">{nav.map(([n, h, cls]) => <a class={cls} href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{n}</a>)}</nav>
  <form class="search" role="search" onsubmit="return false">
    <label class="sr" for="q">Search tire lines, brands and sizes</label>
    <input id="q" type="search" placeholder="Search tires or sizes" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="q-results" aria-autocomplete="list" />
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <ul id="q-results" class="results" role="listbox" aria-label="Search results" hidden></ul>
  </form>
</div></header>
<div class="disc"><div class="wrap"><strong>Disclosure:</strong> <span class="disc-more">TireMileage is independent and sells nothing. </span>{AMAZON_DISCLOSURE}<span class="disc-more"> Amazon links on this site carry our Associates tag; other retailer links are plain. It never changes a ranking.</span> <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/where-to-buy/">Where to buy</a></div></div>
<main id="main"><div class="wrap">
  {crumbs.length > 1 && <Crumbs items={crumbs} />}
  <slot />
  <p class="meta" style="margin-top:32px">Last updated: <time datetime={UPDATED}>{UPDATED}</time> · Data: <a href="https://api.nhtsa.gov/tires?dataSet=ratings" rel="noopener">NHTSA tire ratings (UTQG) API</a>, pulled {UPDATED}. {S.raw_records.toLocaleString()} records.</p>
</div></main>
<footer class="site-f"><div class="wrap">
  <div class="cols3">
    <div><h3>{SITE_NAME}</h3><p>An independent reference that turns the U.S. government’s tire grading data into plain-English comparisons. Early staged release.</p></div>
    <div><h3>Explore</h3><ul><li><a href="/tires/">Tire lines</a></li><li><a href="/sizes/">Sizes</a></li><li><a href="/where-to-buy/">Where to buy</a></li><li><a href="/guides/">Guides</a></li><li><a href="/treadwear/">By treadwear</a></li><li><a href="/type/">By category</a></li><li><a href="/rim/">By rim size</a></li><li><a href="/methodology/">Methodology</a></li><li><a href="/data/">Download data</a></li></ul></div>
    <div><h3>Trust</h3><ul><li><a href="/about/">About &amp; disclosure</a></li><li><a href="https://www.nhtsa.gov/vehicle-safety/tires" rel="noopener">NHTSA TireWise</a></li><li><a href="/sitemap/">Site map</a></li><li><a href="/guides/feed.xml">Guides feed</a></li><li><a href="/llms.txt">llms.txt</a></li></ul></div>
  </div>
  <nav class="legal-links" aria-label="Legal"><ul>{LEGAL_LINKS.map((l) => <li><a href={l.href}>{l.name}</a></li>)}</ul></nav>
  <p class="fine">Source: U.S. National Highway Traffic Safety Administration (NHTSA) Uniform Tire Quality Grading data, a U.S. federal government work. Grades are assigned by tire makers; they are not mileage guarantees. Tire data here is informational, not safety advice (<a href="/disclaimer/">disclaimer</a>). Not affiliated with NHTSA or any tire maker or retailer. Prices are not shown; manufacturer warranty figures appear only where cited from the maker’s own page.</p>
  <p class="fine">{AMAZON_DISCLOSURE}</p>
</div></footer>
<script>import '../scripts/site.ts';</script>
{GA4_ID && <script is:inline define:vars={{ GA4_ID }}>
/* GA4, only when GA4_ID was set at build time. Not loaded if Do Not Track or Global Privacy Control is on.
   gtag.js is injected as an async script only after the window load event + browser idle, so it never blocks rendering and adds no DOM/layout. */
(function () {
  var n = navigator, w = window;
  if (n.globalPrivacyControl || n.doNotTrack === '1' || n.doNotTrack === 'yes' || w.doNotTrack === '1' || n.msDoNotTrack === '1') return;
  function start() {
    w.dataLayer = w.dataLayer || [];
    function gtag() { w.dataLayer.push(arguments); }
    w.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA4_ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA4_ID);
    document.head.appendChild(s);
  }
  function schedule() { if ('requestIdleCallback' in w) w.requestIdleCallback(start, { timeout: 5000 }); else setTimeout(start, 3000); }
  if (document.readyState === 'complete') schedule(); else w.addEventListener('load', schedule);
})();
</script>}
</body>
</html>
